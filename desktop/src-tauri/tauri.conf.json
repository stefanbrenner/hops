{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HOPS",
  "version": "3.3.8",
  "identifier": "com.exoworldsspies.hops",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Education",
    "shortDescription": "HOlomon Photometric Software",
    "longDescription": "Photometric analysis of exoplanet transits observed with small ground-based telescopes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/engine/": "engine/"
    }
  }
}
